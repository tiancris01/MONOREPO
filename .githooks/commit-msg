#!/bin/bash

# Commit message validation hook
# Validates commit message format: TYPE: Description

commit_msg_file="$1"
commit_msg=$(cat "$commit_msg_file")

# Colors
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m'

echo "💬 Validating commit message..."

# Check if commit message follows conventional format
if [[ ! $commit_msg =~ ^(FEAT|FIX|DOCS|CHORE|TEST|REFACTOR|PERF|CI):\ .+ ]]; then
    echo -e "${RED}❌ Invalid commit message format${NC}"
    echo -e "${RED}Current message: $commit_msg${NC}"
    echo ""
    echo -e "${YELLOW}Expected format: TYPE: Description${NC}"
    echo -e "${YELLOW}Valid types: FEAT, FIX, DOCS, CHORE, TEST, REFACTOR, PERF, CI${NC}"
    echo ""
    echo -e "${YELLOW}Examples:${NC}"
    echo -e "${YELLOW}  FEAT: Add ProductCard widget${NC}"
    echo -e "${YELLOW}  FIX: Resolve login crash${NC}"
    echo -e "${YELLOW}  DOCS: Update README${NC}"
    echo -e "${YELLOW}  CHORE: Update dependencies${NC}"
    echo ""
    exit 1
fi

# Check message length (should not be too short)
if [ ${#commit_msg} -lt 10 ]; then
    echo -e "${RED}❌ Commit message too short (minimum 10 characters)${NC}"
    exit 1
fi

# Check message length (should not be too long)
if [ ${#commit_msg} -gt 72 ]; then
    echo -e "${YELLOW}⚠️  Commit message is quite long (${#commit_msg} characters)${NC}"
    echo -e "${YELLOW}Consider keeping it under 72 characters for better readability${NC}"
fi

echo -e "${GREEN}✅ Commit message is valid${NC}"
