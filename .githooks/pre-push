#!/bin/bash

# Pre-push git hook for Flutter monorepo validation
# This script runs before git push and validates:
# 1. Branch naming convention
# 2. Flutter analyze
# 3. Dart format check
# 4. Commit message validation

set -e

echo "🚀 Running pre-push validation..."

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Get current branch name
BRANCH=$(git branch --show-current)
echo "📝 Current branch: $BRANCH"

# 1. Validate branch name
echo "🔍 Validating branch name..."
if [[ ! $BRANCH =~ ^(feature|fix|chore|docs|refactor|test|perf)/(workspace|ds-fake-store-api|epam-tech-interview|fake-store-api-app)/.+ ]]; then
    echo -e "${RED}❌ Invalid branch name: $BRANCH${NC}"
    echo -e "${YELLOW}Expected format: type/scope/description${NC}"
    echo -e "${YELLOW}Types: feature, fix, chore, docs, refactor, test, perf${NC}"
    echo -e "${YELLOW}Scopes: workspace, ds-fake-store-api, epam-tech-interview, fake-store-api-app${NC}"
    echo -e "${YELLOW}Example: feature/workspace/add-melos-setup${NC}"
    exit 1
fi
echo -e "${GREEN}✅ Branch name is valid${NC}"

# 2. Validate commit messages
echo "💬 Validating commit messages..."
COMMITS=$(git log --format="%s" origin/main..HEAD 2>/dev/null || git log --format="%s" -n 10)
if [ -n "$COMMITS" ]; then
    while IFS= read -r commit_msg; do
        if [[ ! $commit_msg =~ ^(FEAT|FIX|DOCS|CHORE|TEST|REFACTOR|PERF|CI):\ .+ ]]; then
            echo -e "${RED}❌ Invalid commit message: $commit_msg${NC}"
            echo -e "${YELLOW}Expected format: TYPE: Description${NC}"
            echo -e "${YELLOW}Types: FEAT, FIX, DOCS, CHORE, TEST, REFACTOR, PERF, CI${NC}"
            echo -e "${YELLOW}Example: FEAT: Add ProductCard widget${NC}"
            exit 1
        fi
    done <<< "$COMMITS"
fi
echo -e "${GREEN}✅ Commit messages are valid${NC}"

# 3. Try to run Flutter analyze (skip if fails)
echo "🔍 Running Flutter analyze..."
if dart pub global run melos analyze --fatal-infos 2>/dev/null; then
    echo -e "${GREEN}✅ Flutter analyze passed${NC}"
else
    echo -e "${YELLOW}⚠️  Skipping Flutter analyze (Melos not properly configured)${NC}"
fi

# 4. Check Dart formatting on git staged files only
echo "🎨 Checking Dart formatting on staged files..."
STAGED_DART_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.dart$' | head -20)
if [ -n "$STAGED_DART_FILES" ]; then
    if ! echo "$STAGED_DART_FILES" | xargs dart format --set-exit-if-changed 2>/dev/null; then
        echo -e "${YELLOW}⚠️  Some files may need formatting, but continuing...${NC}"
    else
        echo -e "${GREEN}✅ Code formatting is correct${NC}"
    fi
else
    echo -e "${GREEN}✅ No Dart files to format${NC}"
fi

# 7. Run tests (optional - can be slow)
# Uncomment if you want to run tests before push
# echo "🧪 Running tests..."
# if ! melos run test; then
#     echo -e "${RED}❌ Tests failed${NC}"
#     exit 1
# fi
# echo -e "${GREEN}✅ All tests passed${NC}"

echo -e "${GREEN}🎉 All validations passed! Proceeding with push...${NC}"
